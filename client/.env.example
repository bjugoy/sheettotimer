# ── Supabase (required for auth + rooms) ──────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUB_KEY=sb_publishable_...

# ── RevenueCat (required for paid plan purchases) ─────────────────────────────
# Find in: RC Dashboard → Project → API Keys → Public app-specific key (starts with rcb_)
VITE_REVENUECAT_API_KEY=rcb_...

# ── Server URL ────────────────────────────────────────────────────────────────
# Leave unset in development (Vite proxy handles it).
# In production (Vercel), set this to your Heroku app URL:
VITE_SERVER_URL=https://your-app-name.herokuapp.com
