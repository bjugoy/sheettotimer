# ── Supabase (required for JWT verification on room:create) ───────────────────
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...   # keep secret — never expose to client

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CLIENT_URL=https://your-app-name.vercel.app
SESSION_SECRET=change-me-in-production

# ── RevenueCat (required for webhook plan updates) ────────────────────────────
# Set this in RC Dashboard → Integrations → Webhooks → Authorization header value
REVENUECAT_WEBHOOK_SECRET=your-webhook-secret

# ── Google Sheets (optional) ──────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
